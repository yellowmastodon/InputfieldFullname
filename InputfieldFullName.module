<?php

namespace ProcessWire;

class InputfieldFullName extends Inputfield implements Module
{
    public static function getModuleInfo()
    {
        return [
            'title' => 'Full Name Selector',
            'summary' => 'Generates full name combinations from first and last name fields and stores in a hidden field of user\'s choosing.',
            'author' => 'Juraj Mydla',
            'version' => 002,
            'installs' => 'FieldtypeFullName',
        ];
    }

    public function init()
    {
        $this->set('firstNameField', '');
        $this->set('lastNameField', '');
        $this->set('fullNameField', '');
        $this->set('appendField', '');
        $this->set('prependField', '');
        parent::init();
        $this->forceRenderHiddenField();
    }

    public function forceRenderHiddenField()
    {
        static $hiddenFieldsHooked = [];

        $this->addHookAfter('Field::getInputfield', function (HookEvent $event) use (&$hiddenFieldsHooked) {
            if (!in_array($this->page->process, ['ProcessPageAdd', 'ProcessPageEdit'], true)) return;
            $targetHiddenField = $this->get('fullNameField');
            $field = $event->object;
            $inputfield = $event->return;
            if ($field->name === $targetHiddenField  && !in_array($inputfield->name, $hiddenFieldsHooked)) {
                $hiddenFieldsHooked[] = $inputfield->name;
                if ($inputfield->collapsed = Inputfield::collapsedHidden) {
                    $inputfield->set('collapsed', Inputfield::collapsedNo);
                    $inputfield->set('id', $inputfield->id());
                    $inputfield->addClass('uk-hidden', 'wrapClass');
                }
                $event->return = $inputfield;
            }
        });
    }

    /**
     * Helper to format value with optional prepend/append patterns.
     */
    protected function formatNameValue($rawName, $page)
    {
        if (!trim($rawName)) return '';

        $prependPattern = $this->get('prependField');
        $appendPattern = $this->get('appendField');

        // Replace any {fieldname} tags with page values
        $formatter = function($pattern) use ($page, $rawName) {
            if (!trim($pattern)) return '';
            return preg_replace_callback('/\{([a-zA-Z0-9_\-]+)\}/', function($matches) use ($page) {
                $fieldName = $matches[1];
                return $page->hasField($fieldName) ? (string) $page->get($fieldName) : '';
            }, $pattern);
        };

        $prepend = $formatter($prependPattern);
        $append = $formatter($appendPattern);

        return trim($prepend . ' ' . $rawName . ' ' . $append);
    }

    public function ___render()
    {
        $page = $this->hasPage;
        $firstNameField = $this->get('firstNameField');
        $lastNameField = $this->get('lastNameField');
        $targetHiddenField = $this->get('fullNameField');

        $missing_f = [];
        foreach ([$firstNameField, $lastNameField, $targetHiddenField] as $fieldName) {
            if (!$page->hasField($fieldName)) $missing_f[] = '"' . $fieldName . '"';
        }

        if (!empty($missing_f)) {
            return '<p class="ui-state-error">' . sprintf($this->_('Template missing fields set in this inputfield: %s'), implode(", ", $missing_f)) . '</p>';
        }

        $first_name = trim($page->get($firstNameField));
        $last_name = trim($page->get($lastNameField));
        $full_name = trim($page->get($targetHiddenField));

        $rawOpt1 = trim($first_name . ' ' . $last_name);
        $rawOpt2 = trim($last_name . ' ' . $first_name);

        $opt1 = $this->formatNameValue($rawOpt1, $page);
        $opt2 = $this->formatNameValue($rawOpt2, $page);
        $placeholder_text = $this->_('Full name of a person');

        $output = '<select id="' . $this->id . '" data-placeholder-option="' . $placeholder_text . '">';
        
        if ($first_name === "" && $last_name === "") {
            $output .= '<option disabled selected="">' . $placeholder_text . '</option>';
        } else if ($first_name === "") {
            $single = $this->formatNameValue($last_name, $page);
            $output .= '<option selected value="' . $single . '">' . $single . '</option>';
        } else if ($last_name === "") {
            $single = $this->formatNameValue($first_name, $page);
            $output .= '<option selected value="' . $single . '">' . $single . '</option>';
        } else {
            $output .= '<option' . ($full_name === $opt1 ? ' selected=""' : '') . ' value="' . $opt1 . '">' . $opt1 . '</option>';
            $output .= '<option' . ($full_name === $opt2 ? ' selected=""' : '') . ' value="' . $opt2 . '">' . $opt2 . '</option>';
        }
        $output .= '</select>';

        $jsInputfieldName = function (string $fieldName) use ($page) {
            if ($page instanceof \ProcessWire\RepeaterPage) {
                return "Inputfield_{$fieldName}_repeater{$page->id}";
            }
            return "Inputfield_{$fieldName}";
        };

        // Pass prepend/append patterns to JS
        $this->config->js('InputfieldFullName', array_merge(
            $this->config->js('InputfieldFullName') ?: [],
            [
                $this->name => [
                    'firstNameField' => $jsInputfieldName($firstNameField),
                    'lastNameField'  => $jsInputfieldName($lastNameField),
                    'fullNameField'  => $jsInputfieldName($targetHiddenField),
                    'fieldNameId'    => $this->id,
                    'prependPattern' => (string) $this->get('prependField'),
                    'appendPattern'  => (string) $this->get('appendField'),
                ]
            ]
        ));

        return $output;
    }

    public function ___getConfigInputfields()
    {
        $inputfields = parent::___getConfigInputfields();
        
        $f = $this->modules->get('InputfieldText');
        $f->attr('name', 'firstNameField');
        $f->label = 'First Name Field Selector (e.g., "first_name")';
        $f->required = true;
        $f->attr('value', $this->getSetting('firstNameField'));
        $inputfields->add($f);

        $f = $this->modules->get('InputfieldText');
        $f->attr('name', 'lastNameField');
        $f->label = 'Last Name Field Selector (e.g., "last_name")';
        $f->required = true;
        $f->attr('value', $this->getSetting('lastNameField'));
        $inputfields->add($f);

        $f = $this->modules->get('InputfieldText');
        $f->attr('name', 'fullNameField');
        $f->label = 'Hidden Field to Populate (e.g., "title")';
        $f->required = true;
        $f->attr('value', $this->getSetting('fullNameField'));
        $inputfields->add($f);

        $f = $this->modules->get('InputfieldText');
        $f->attr('name', 'appendField');
        $f->label = 'Optional field to append';
        $f->attr('value', $this->getSetting('appendField'));
        $f->notes = "To append other characters use e.g.: \"Some text: {field_name}\"";
        $inputfields->add($f);

        $f = $this->modules->get('InputfieldText');
        $f->attr('name', 'prependField');
        $f->label = 'Optional field to prepend';
        $f->notes = "To prepend other characters use e.g.: \"Some text: {field_name}\"";
        $f->attr('value', $this->getSetting('prependField'));
        $inputfields->add($f);

        return $inputfields;
    }
}